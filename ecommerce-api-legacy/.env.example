# Exporte estas variáveis no shell antes de subir a API (este projeto não lê arquivo .env). Nada aqui é segredo real.
PORT=3000
# Banco SQLite; o padrão é em memória (recriado com seed a cada boot)
DB_PATH=:memory:
# Chave do gateway de pagamento; vazio = gateway simulado
PAYMENT_GATEWAY_KEY=
# Token exigido no header X-Admin-Token das rotas administrativas; vazio = rotas bloqueadas (403)
ADMIN_TOKEN=
