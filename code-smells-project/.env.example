# Copie para .env (ou exporte no shell) e preencha com valores reais. Nada aqui é segredo real.
SECRET_KEY=
# Token exigido no header X-Admin-Token das rotas /admin/*; vazio = rotas admin bloqueadas (403)
ADMIN_TOKEN=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
DATABASE_PATH=loja.db
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
